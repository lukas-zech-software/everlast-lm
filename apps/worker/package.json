{
  "name": "@everlast/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@everlast/cloud": "workspace:*",
    "@everlast/contracts": "workspace:*",
    "@everlast/db": "workspace:*",
    "@everlast/notes": "workspace:*",
    "@google/genai": "^2.32.0",
    "@mozilla/readability": "^0.6.0",
    "google-auth-library": "^11.3.3",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@everlast/testkit": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "@google-cloud/storage": "^8.4.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
