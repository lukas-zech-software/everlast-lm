{
  "name": "@everlast/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@everlast/cloud": "workspace:*",
    "@everlast/contracts": "workspace:*",
    "@everlast/db": "workspace:*",
    "@everlast/worker": "workspace:*",
    "@google/adk": "2.3.0",
    "@google/genai": "^2.30.0",
    "exceljs": "4.4.0",
    "google-auth-library": "^9.15.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@everlast/testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  },
  "types": "./src/server.ts",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  }
}
