{
  "name": "everlast-lm",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Spec-driven, agent-built re-implementation of Gemini Notebook (NotebookLM) on Google Cloud",
  "homepage": "https://github.com/lukas-zech-software/everlast-lm#readme",
  "bugs": {
    "url": "https://github.com/lukas-zech-software/everlast-lm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukas-zech-software/everlast-lm.git"
  },
  "author": "Lukas Zech",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "directories": {
    "doc": "docs",
    "spec": "spec",
    "infra": "infra"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-web.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "node scripts/lint.mjs",
    "check:specs": "node scripts/check-spec-integrity.mjs",
    "sync:project": "node scripts/sync-github-project.mjs",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run packages/contracts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=chromium",
    "eval:deterministic": "node packages/evals/src/cli.ts deterministic",
    "eval:judged": "env -u GEMINI_API_KEY -u GOOGLE_API_KEY -u GOOGLE_GENAI_API_KEY node packages/evals/src/cli.ts release",
    "db:migrate": "node packages/db/src/cli/migrate.ts",
    "dev": "node scripts/dev.mjs",
    "infra:fmt": "tofu fmt -recursive infra",
    "infra:fmt:check": "tofu fmt -check -recursive infra",
    "infra:init:local": "tofu -chdir=infra/environments/dev init -backend=false && tofu -chdir=infra/environments/staging init -backend=false && tofu -chdir=infra/environments/prod init -backend=false",
    "infra:validate": "tofu -chdir=infra/environments/dev validate && tofu -chdir=infra/environments/staging validate && tofu -chdir=infra/environments/prod validate",
    "infra:status": "node scripts/infra-status.mjs",
    "infra:pause": "node scripts/infra-ops.mjs pause",
    "infra:start": "node scripts/infra-ops.mjs start",
    "infra:resume": "node scripts/infra-ops.mjs start",
    "infra:warmup": "node scripts/infra-ops.mjs warmup",
    "infra:cooldown": "node scripts/infra-ops.mjs cooldown",
    "build:web": "node scripts/build-web.mjs",
    "test": "vitest run",
    "db:test:up": "node scripts/db-test.mjs up",
    "db:test:down": "node scripts/db-test.mjs down",
    "eval:v3-audio": "node scripts/eval-v3-audio.mjs",
    "eval:v3-code-execution": "node scripts/eval-v3-code-execution.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.2"
  }
}
