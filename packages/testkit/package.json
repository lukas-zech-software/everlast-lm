{
  "name": "@everlast/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test-only fixture builders (deterministic PDFs). Never imported by production code.",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.2"
  }
}
